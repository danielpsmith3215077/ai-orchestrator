# --- App ---
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- LLM (pick at least one; Groq recommended free tier) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=auto

# Hugging Face Inference (OpenAI-compatible router) — optional fallback
HF_API_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_CHAT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Supabase + pgvector (recommended cloud memory) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres URL (not required for PostgREST path)
DATABASE_URL=

# Local SQLite fallback path (used when Supabase unset)
LOCAL_MEMORY_PATH=data/local_memory.db

# --- Self-evolution cron (runs inside the web process) ---
CRON_ENABLED=true
CRON_HOUR_UTC=3
CRON_MINUTE_UTC=0
EVOLUTION_INTERVAL_HOURS=24
MEMORY_TOP_K=8
PRUNE_FORGOTTEN_AFTER_DAYS=90
MIN_IMPORTANCE_KEEP=0.15

# --- Web search ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
